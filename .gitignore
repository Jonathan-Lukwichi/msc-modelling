# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Virtual envs
.venv/
venv/
env/
ENV/

# Notebooks
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
*.swp
*~

# Local secrets and overrides
.env
.env.*
*.local.yaml
configs/paths.local.yaml

# -- Project-specific --
# Large or sensitive data files we never commit
data/raw/
data/processed/
data/external/

# Trained model pickles and predictions regenerate from the scripts;
# don't bloat the repo with them. Metrics, figures, tables are committed.
artefacts/models/
artefacts/predictions/

# Background task outputs / temp files
*.log
*.tmp

# -- Reproducibility platform --
# MLflow's local run history. Each contributor/CI run accumulates its
# own mlruns/ locally (or points MLFLOW_TRACKING_URI at a shared
# server); this is generated state, not source, and grows without
# bound, so it isn't committed. What IS committed is the code that
# produces it (src/forecasting/mlflow_utils.py) and, permanently, the
# metrics it logged (they also land in artefacts/metrics/*.csv and the
# leaderboard parquet via the normal script output path).
mlruns/

# DVC's local cache of tracked file content (separate from dvc.lock and
# the .dvc/config, which ARE committed).
/.dvc/cache/
/.dvc/tmp/
